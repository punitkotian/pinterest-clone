<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
    <script src="/js/pin-comment.js" defer></script>
    <script src="/js/download.js" defer></script>
    <script src="/js/imageLoad.js" defer></script>
  </head>
  <body>
    <%- include('../partials/header', { user: data.user }); %>

    <div class="main">
      <% if (typeof data !== 'undefined') { %>
      <div class="wrapper">
        <div class="section">
          <div class="block-1">
            <img
              data-lazy="/uploads/<%= data?.pin?.image %>"
              class="pin-image"
              alt="no image"
            />
          </div>
          <div class="block-2">
            <div class="row-1">
              <div class="btn-container">
                <a
                  href="/uploads/<%= data?.pin?.image %>"
                  class="btn rounded-circle download-btn"
                >
                  <span class="material-symbols-outlined"> download </span>
                </a>
                <a
                  href="/save-pin/<%= data?.pin?._id %>"
                  class="btn btn-danger rounded-full save-btn body-medium"
                >
                  Save
                </a>
              </div>
            </div>
            <div class="row-2">
              <div class="pin-details">
                <!-- <div class="pin-info"> -->
                <h2 class="heading-medium"><%= data?.pin?.title %></h2>
                <p class="pin-description body-medium">
                  <%= data?.pin?.description %>
                </p>
                <div class="pin-creator">
                  <div class="avatar">
                    <img
                      data-lazy="/uploads/<%= data?.pin?.creator?.avatar %>"
                      alt=""
                      class="rounded-circle"
                    />
                  </div>
                  <div>
                    <h4 class="title-medium">
                      <%= data?.pin?.creator?.fullName %>
                    </h4>
                      <a classs="title-small" href="/<%= data?.pin?.creator?.username %>/profile_pins" class="text-wrap body-small">
                        @<%= data?.pin?.creator?.username %>
                      </a>                    
                  </div>
                </div>
                <!-- </div> -->
              </div>
              <div class="drop-down">
                <div class="drop-down-btn">
                  <h5 class="title-medium">Comments</h5>

                  <% if (data?.pin?.commentsCount !== 0) { %>
                  <span class="material-symbols-outlined">
                    keyboard_arrow_down
                  </span>
                  <% } %>
                </div>
                <% if (data?.pin?.commentsCount === 0) { %>
                <p
                  class="msg label-medium"
                  style="color: #998e8e; margin-top: 15px"
                >
                  No comments yet! Add one to start the conversation.
                </p>
                <%} else { %>
                <div class="drop-down-area">
                  <div class="comment-container">
                    <% data?.pin?.comments?.forEach( function (comment) { %> <%-
                    include('./comment', {comment: comment} ); %> <% }) %>
                  </div>
                </div>
                <% } %>
              </div>
            </div>
            <div class="divider"></div>
            <div class="row-3">
              <div class="writing">
                <div style="margin-bottom: 15px">
                  <h3 class="title-large">
                    <span class="comment-count"
                      ><%= data?.pin?.commentsCount === 0 ? "" : data?.pin?.commentsCount %> </span
                    >  <% if (data?.pin?.commentsCount === 0) { %>
                      What do you think?
                  <% } else if (data?.pin?.commentsCount === 1) { %>
                      Comment
                  <% } else { %>
                      Comments
                  <% } %>
                  
                  </h3>

                  <div class="like-info">
                    <span class="like-count title-medium"
                      ><%= data?.pin?.likesCount %></span
                    >
                    <button class="btn rounded-circle heart-btn">
                      <span
                        class="material-symbols-outlined <% if (data?.pin?.isLiked) { %> red <% } %>"
                      >
                        favorite
                      </span>
                    </button>
                  </div>
                </div>
                <div>
                  <div class="avatar">
                    <img
                      data-lazy="/uploads/<%= data?.user?.avatar %>"
                      alt=""
                      class="rounded-circle"
                    />
                  </div>
                  <form
                    action="/create-comment/<%= data?.pin?._id %>"
                    method="post"
                  >
                    <input
                      type="text"
                      name="comment_text"
                      placeholder="Add a comment"
                      class="rounded-full body-medium"
                      required
                    />
                    <button class="btn btn-danger rounded-circle send-btn">
                      <span class="material-symbols-outlined"> send </span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>
    <script>
      const heartBtn = document.querySelector(".heart-btn");
      const likeCount = document.querySelector(".like-count");
      const heartIcon = document.querySelector(".heart-btn span");
      heartBtn.addEventListener("click", toggleHeart);
      async function toggleHeart() {
        heartIcon.classList.toggle("red");
        
        const url = window.location.href;
        const id = url.match(/\/pin\/([\w-]+)/)[1];
        
        const response = await fetch(`/${id}/toggle-pin-like`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        });
        
        if (!response.ok) {
          alert("Something went wrong");
        } else {
          if (heartIcon.classList.contains("red")){
            likeCount.innerText = (parseInt(likeCount.innerText) + 1).toString();
          } else {
            likeCount.innerText = (parseInt(likeCount.innerText) - 1).toString();
          }
        }
      }
    </script>
  </body>
</html>
