<div class="form-container">
  <form>
    <div class="edit-board-container">
      <div class="top">
        <h2 class="edit-board-title heading-medium">Edit Board</h2>
        <button type="button" class="btn cancel-board-btn cancel-btn">
          <span class="material-symbols-outlined"> close </span>
        </button>
      </div>
      <div class="fill-board-details">
        <input
          type="text"
          class="title rounded-sm body-medium"
          placeholder="Title"
          name="title"
        />
        <textarea
          name="description"
          id=""
          class="description rounded-sm body-medium"
        ></textarea>
        <div class="btn-container">
          <button class="btn btn-danger save-board-btn save-btn rounded-sm body-medium">
            Save
          </button>
          <button class="btn btn-danger delete-board-btn delete-btn rounded-sm body-medium">
            Delete
          </button>
        </div>
      </div>
    </div>
  </form>
</div>
